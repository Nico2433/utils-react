{
  "name": "@nico2433/utils-react",
  "version": "1.0.49",
  "description": "React components and hooks for personal projects, styled with Tailwind CSS",
  "author": "nico2433",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/theme.css','dist/theme.css')\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./theme.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:package && commit-and-tag-version && git push --follow-tags"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nico2433/utils-react.git"
  },
  "bugs": {
    "url": "https://github.com/Nico2433/utils-react/issues"
  },
  "homepage": "https://github.com/Nico2433/utils-react#readme",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@nico2433/utils": "^2.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2"
}
